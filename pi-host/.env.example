# Copy to .env, then keep the real file local and mode 0600.
# `npm run model -- use <model>` changes only the active selection.
TIMESIGMA_LLM_PROVIDER=openai
TIMESIGMA_LLM_MODEL_ID=gpt-5.5
TIMESIGMA_LLM_REASONING=xhigh

# Configure one or both credentials. Never commit real values.
TIMESIGMA_OPENAI_API_KEY=
TIMESIGMA_OPENAI_BASE_URL=https://api.openai.com/v1

TIMESIGMA_DEEPSEEK_API_KEY=
# Strict JSON-schema tools use DeepSeek's documented beta route.
TIMESIGMA_DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
